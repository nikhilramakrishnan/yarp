[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=YarpPreview
GenericName=TerminalEmulator

Exec=yarp-terminal-preview %U
StartupWMClass=dev.yarp.YarpPreview

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.yarp.YarpPreview

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for yarppreview:// URLs.
MimeType=x-scheme-handler/yarppreview;
