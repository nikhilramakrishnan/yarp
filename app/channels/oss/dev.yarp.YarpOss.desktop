[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=YarpOss
GenericName=TerminalEmulator

Exec=yarp-oss %U
StartupWMClass=dev.yarp.YarpOss

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.yarp.YarpOss

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for yarposs:// URLs.
MimeType=x-scheme-handler/yarposs;
