[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Yarp
GenericName=TerminalEmulator

Exec=yarp-terminal %U
StartupWMClass=dev.yarp.Yarp

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.yarp.Yarp

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for yarp:// URLs.
MimeType=x-scheme-handler/yarp;
